# Deployment key. The scripts assume deployer == owner, so this key must match
# the OWNER in script/Config.sol (0xbB64D716FAbDEC3a106bb913Fb4f82c1EeC851b8),
# otherwise the upgrade step is skipped.
# You can also leave this unset and use forge's --account <keystore> / --ledger.
PRIVATE_KEY=

# RPC
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=
MAINNET_RPC_URL=

# Contract verification
ETHERSCAN_API_KEY=
