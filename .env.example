# Deployment key. The scripts assume deployer == owner, so this key must match
# the OWNER in script/Config.sol (0xbB64D716FAbDEC3a106bb913Fb4f82c1EeC851b8),
# otherwise the upgrade step is skipped.
# You can also leave this unset and use forge's --account <keystore> / --ledger.
PRIVATE_KEY=

# Where to deploy. These feed the `target` / `target_test` rpc aliases in
# foundry.toml and the make targets that use them.
TARGET_RPC_URL=
TARGET_TESTNET_RPC_URL=

# Explorer verification endpoints, used by `make src` / `make src-test`.
# Blockscout instances need no API key; point these at <explorer>/api.
EXPLORER_API=
EXPLORER_TESTNET_API=

# Only needed for Etherscan-family explorers (see [etherscan] in foundry.toml).
ETHERSCAN_API_KEY=

# RPC for the reference networks kept in foundry.toml
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=
MAINNET_RPC_URL=
